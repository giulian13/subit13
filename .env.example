# Exemplu de variabile de mediu pentru conectarea la Firebase
# Înlocuiește valorile de mai jos cu cele din consola ta Firebase (Project Settings -> General -> Your apps -> Web app)

VITE_FIREBASE_API_KEY=AIzaSyExempluCheieFirebase123456789
VITE_FIREBASE_AUTH_DOMAIN=edusmart-exemplu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=edusmart-exemplu
VITE_FIREBASE_STORAGE_BUCKET=edusmart-exemplu.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
